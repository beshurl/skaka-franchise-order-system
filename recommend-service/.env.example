# 로컬 실행용 예시입니다. 실제 키가 들어간 .env 파일은 Git에 포함하지 않습니다.
APP_PORT=8085
APP_NAME=recommend-service

EUREKA_SERVER_URL=http://localhost:8761/eureka
EUREKA_INSTANCE_HOST=localhost
JWT_ISSUER_URI=http://localhost:8080
JWK_SET_URI=http://localhost:9000/oauth2/jwks

ENROLLMENT_SERVICE_URL=http://localhost:8083
COURSE_SERVICE_URL=http://localhost:8082
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# https://platform.openai.com/api-keys 에서 발급한 서버용 키
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=20
